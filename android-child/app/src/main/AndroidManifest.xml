<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Tarmoq -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

  <!-- Kamera -->
  <uses-permission android:name="android.permission.CAMERA"/>

  <!-- Screen capture -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>

  <!-- ✅ Lokatsiya -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

  <!-- Avtomatik ishga tushish -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

  <application android:theme="@style/Theme.Child" android:label="Family Guard">

    <!-- Device Admin -->
    <receiver
      android:name=".DeviceAdminReceiver"
      android:label="Family Guard"
      android:description="@string/device_admin_description"
      android:permission="android.permission.BIND_DEVICE_ADMIN"
      android:exported="true">
      <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin_receiver"/>
      <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED"/>
        <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED"/>
        <action android:name="android.app.action.DEVICE_ADMIN_DISABLED"/>
      </intent-filter>
    </receiver>

    <!-- Boot va internet receiver -->
    <receiver
      android:name=".BootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
        <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
        <action android:name="android.net.conn.CONNECTIVITY_CHANGE"/>
      </intent-filter>
    </receiver>

    <!-- Asosiy ekran -->
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>

    <!-- ✅ Service: mediaProjection + camera + location -->
    <service
      android:name=".ScreenCaptureService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection|camera|location"/>

  </application>
</manifest>
